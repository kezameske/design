# OpenRouter API key — get from https://openrouter.ai/keys
# Default backend. 30MB input limit per request.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Google AI Studio API key — get from https://aistudio.google.com/app/apikey
# If set, gemini.py auto-switches to direct Google API + Files API for inputs
# larger than 18MB (no 30MB limit). Leave blank to stay on OpenRouter.
# GOOGLE_API_KEY=
